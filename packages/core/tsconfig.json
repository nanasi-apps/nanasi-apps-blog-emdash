{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "./src",
		"declaration": true,
		"declarationMap": true,
		"noUncheckedIndexedAccess": false,
		"lib": ["es2024", "DOM", "DOM.Iterable", "esnext.typedarrays"],
		"types": ["astro/client"]
	},
	"include": ["src/**/*"],
	"exclude": [
		"node_modules",
		"dist",
		"tests",
		"src/astro/**",
		"src/components/**",
		"src/preview/**",
		"src/ui.ts",
		"src/auth/providers/*-admin.tsx"
	]
}
